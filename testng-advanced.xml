<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="ShopFlow Advanced Selenium" verbose="1" output-directory="target/testng-reports/advanced">
