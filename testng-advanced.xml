            <class name="com.shopflow.tests.advanced.WindowsAdvancedCases"/>
            <class name="com.shopflow.tests.advanced.ActionsAdvancedCases"/>
            <class name="com.shopflow.tests.advanced.KeyboardAdvancedCases"/>
            <class name="com.shopflow.tests.advanced.DropdownsAdvancedCases"/>
            <class name="com.shopflow.tests.advanced.DynamicAdvancedCases"/>
            <class name="com.shopflow.tests.advanced.FileUploadAdvancedCases"/>
            <class name="com.shopflow.tests.advanced.ShadowDomAdvancedCases"/>
            <class name="com.shopflow.tests.advanced.ScrollingAdvancedCases"/>
        </classes>
    </test>
</suite>
