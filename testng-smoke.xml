<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="ShopFlow Smoke" verbose="1" output-directory="target/testng-reports/smoke">
    <test name="Critical business flows">
        <groups><run><include name="smoke"/></run></groups>
        <classes>
            <class name="com.shopflow.tests.FirstLoginTest"/>
            <class name="com.shopflow.tests.LoginTest"/>
            <class name="com.shopflow.tests.ProductTest"/>
            <class name="com.shopflow.tests.CartTest"/>
            <class name="com.shopflow.tests.CheckoutTest"/>
        </classes>
    </test>
</suite>
