<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.1.dtd">
<suite name="ShopFlow Parallel Original Regression" verbose="1" parallel="classes"
       thread-count="3" output-directory="target/testng-reports/parallel-original-regression">
    <test name="Original 49 business scenarios">
        <groups><run><include name="regression"/></run></groups>
        <classes>
            <class name="com.shopflow.tests.FirstLoginTest"/>
            <class name="com.shopflow.tests.LoginTest"/>
            <class name="com.shopflow.tests.ProductTest"/>
            <class name="com.shopflow.tests.CartTest"/>
            <class name="com.shopflow.tests.CheckoutTest"/>
        </classes>
    </test>
</suite>
