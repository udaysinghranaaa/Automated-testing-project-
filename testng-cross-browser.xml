<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.1.dtd">
<suite name="ShopFlow Cross-Browser Smoke" verbose="1" parallel="tests" thread-count="2"
       output-directory="target/testng-reports/cross-browser">
    <test name="Chrome critical journey">
        <parameter name="browser" value="chrome"/>
        <classes><class name="com.shopflow.tests.CrossBrowserSmokeCases"/></classes>
    </test>
    <test name="Edge critical journey">
        <parameter name="browser" value="edge"/>
        <classes><class name="com.shopflow.tests.CrossBrowserSmokeCases"/></classes>
    </test>
</suite>
